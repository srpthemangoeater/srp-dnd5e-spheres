{{!-- One accordion row: the header toggles the description. Right-click opens the context menu. --}}
{{#*inline "row"}}
<li class="sp-row {{#if row.open}}open{{/if}}" data-collapse-key="{{ row.key }}" data-sort-id="{{ row.id }}"
    data-spheres-context data-context-type="{{ type }}" data-spheres-item-id="{{ row.id }}"
    {{#if editable}}draggable="true"{{/if}}>
    <div class="sp-row-head" data-spheres-toggle role="button" tabindex="0" aria-expanded="{{#if row.open}}true{{else}}false{{/if}}">
        <i class="fas fa-chevron-right sp-chevron" inert></i>
        <img src="{{ row.img }}" alt="">
        <span class="sp-row-name">{{ row.name }}</span>
        <span class="sp-badges">{{> @partial-block }}</span>
    </div>
    <div class="sp-row-body">
        {{#each row.description}}<p>{{ this }}</p>{{else}}<p class="hint">{{ localize "DND5E-SPHERES.NoDescription" }}</p>{{/each}}
    </div>
</li>
{{/inline}}

<div class="dnd5e-spheres-content {{#if spheres.editable}}editing{{/if}}">
{{#with spheres}}

    {{!-- Casting tradition --}}
    <div class="spheres-card tradition">
        <div class="spheres-card-header">
            <div {{#if tradition}}data-spheres-context data-context-type="tradition"{{/if}}>
                {{#if tradition}}
                <span class="tradition-name">{{ tradition.name }}</span>
                {{else}}
                <span class="tradition-name empty">{{ localize "DND5E-SPHERES.NoTradition" }}</span>
                {{/if}}
                <div class="subtitle">
                    {{#if kamLabel}}
                    {{ localize "DND5E-SPHERES.KeyAbility" }}: {{ kamLabel }} ({{ dnd5e-formatModifier kamMod }})
                    &middot; {{ localize "DND5E-SPHERES.SphereDC" }} {{ dc }}
                    &middot; {{ localize "DND5E-SPHERES.Attack" }} {{ dnd5e-formatModifier attack }}
                    {{else}}
                    {{ localize "DND5E-SPHERES.NoKeyAbility" }}
                    {{/if}}
                </div>
            </div>
            {{#if owner}}
            <button type="button" class="spheres-button" data-spheres-action="builder">
                <i class="fas fa-pen-ruler" inert></i> {{ localize "DND5E-SPHERES.EditTradition" }}
            </button>
            {{/if}}
        </div>

        {{#each groups as |group type|}}
        {{#if group.items.length}}
        <section class="sp-group {{#if group.open}}open{{/if}}" data-collapse-key="{{ group.key }}">
            <header class="sp-group-head" data-spheres-toggle role="button" tabindex="0" aria-expanded="{{#if group.open}}true{{else}}false{{/if}}">
                <i class="fas fa-chevron-right sp-chevron" inert></i>
                <span>{{ localize (concat "DND5E-SPHERES.Group." type) }}</span>
                <span class="sp-count">{{ group.items.length }}</span>
                {{#if (eq type "drawbacks")}}{{#if ../traditionBonus}}<span class="spheres-tag bonus">{{ localize "DND5E-SPHERES.TraditionBonus" bonus=../traditionBonus }}</span>{{/if}}{{/if}}
            </header>
            <ol class="sp-list" data-sort-group="{{ type }}">
                {{#each group.items as |row|}}
                {{#> row row=row type="item" editable=@root.spheres.editable }}
                    {{#if (gt row.count 1)}}<span class="spheres-tag">&times;{{ row.count }}</span>{{/if}}
                    {{#if (gt row.weight 1)}}<span class="spheres-tag">{{ localize "DND5E-SPHERES.Builder.CountsTwo" }}</span>{{/if}}
                    {{#if row.automated}}<span class="spheres-tag auto">{{ localize "DND5E-SPHERES.Builder.Automated" }}</span>{{/if}}
                {{/row}}
                {{/each}}
            </ol>
        </section>
        {{/if}}
        {{/each}}
    </div>

    {{!-- Spell points --}}
    <div class="spheres-card pool">
        <div class="spheres-card-header">
            <h3><i class="fas fa-atom" inert></i> {{ localize "DND5E-SPHERES.SpellPoints" }}</h3>
            <span class="spheres-tag cap" data-tooltip="DND5E-SPHERES.CapHint">{{ localize "DND5E-SPHERES.Cap" cap=cap }}</span>
        </div>
        {{#if pool.exists}}
        <div class="pool-row">
            <span class="pool-value">{{ pool.value }} / {{ pool.max }}</span>
            <div class="pips" aria-hidden="true">
                {{#each pips}}<i class="pip {{#if spent}}spent{{/if}}"></i>{{/each}}
            </div>
            {{#if owner}}
            <div class="pool-controls">
                <button type="button" class="spheres-button icon" data-spheres-action="spend"
                        data-tooltip="DND5E-SPHERES.SpendOne" aria-label="{{ localize 'DND5E-SPHERES.SpendOne' }}">
                    <i class="fas fa-minus" inert></i>
                </button>
                <button type="button" class="spheres-button icon" data-spheres-action="restore"
                        data-tooltip="DND5E-SPHERES.RestoreOne" aria-label="{{ localize 'DND5E-SPHERES.RestoreOne' }}">
                    <i class="fas fa-plus" inert></i>
                </button>
                <button type="button" class="spheres-button" data-spheres-action="usePool">
                    <i class="fas fa-wand-magic-sparkles" inert></i> {{ localize "DND5E-SPHERES.UsePool" }}
                </button>
            </div>
            {{/if}}
        </div>
        <div class="pool-breakdown">
            {{ localize "DND5E-SPHERES.Breakdown" class=classSP kam=kamMod tradition=traditionBonus manual=manual }}
        </div>
        {{else}}
        <p class="hint">{{ localize "DND5E-SPHERES.NoPool" }}</p>
        {{#if owner}}
        <button type="button" class="spheres-button" data-spheres-action="createPool">
            <i class="fas fa-plus" inert></i> {{ localize "DND5E-SPHERES.CreatePool" }}
        </button>
        {{/if}}
        {{/if}}
    </div>

    {{!-- Spheres & talents --}}
    <div class="spheres-card list">
        <div class="spheres-card-header">
            <h3>{{ localize "DND5E-SPHERES.SpheresAndTalents" }}</h3>
            <span class="header-buttons">
                <span class="spheres-tag talents {{#if talentTracker.over}}over{{/if}}"
                      data-tooltip="{{ localize 'DND5E-SPHERES.TalentsHint' classes=talentTracker.fromClasses tradition=talentTracker.tradition bonus=talentTracker.bonus }}">
                    {{#if talentTracker.unlimited}}{{ localize "DND5E-SPHERES.TalentsKnown" count=talentTracker.spent }}{{else}}{{ localize "DND5E-SPHERES.TalentsUsed" spent=talentTracker.spent total=talentTracker.total }}{{/if}}{{#if talentTracker.overrides}} {{ localize "DND5E-SPHERES.Override.Count" count=talentTracker.overrides }}{{/if}}
                </span>
                {{#if owner}}
                <button type="button" class="spheres-button" data-spheres-action="browse">
                    <i class="fas fa-book-atlas" inert></i> {{ localize "DND5E-SPHERES.Browser.Open" }}
                </button>
                <button type="button" class="spheres-button" data-spheres-action="customTalent" data-tooltip="{{ localize "DND5E-SPHERES.Custom.Title" }}">
                    <i class="fas fa-wand-sparkles" inert></i> {{ localize "DND5E-SPHERES.Custom.Button" }}
                </button>
                {{/if}}
            </span>
        </div>
        {{#if talentTracker.over}}
        <p class="warning">{{ localize "DND5E-SPHERES.TalentsOver" }}</p>
        {{/if}}
        {{#if hasSpheres}}
        <div class="sphere-list" data-sort-group="spheres">
        {{#each sphereList as |sphere|}}
        <section class="sp-group sphere-entry {{#if sphere.groupOpen}}open{{/if}}" data-collapse-key="{{ sphere.groupKey }}"
                 data-sort-id="{{ sphere.id }}" {{#if @root.spheres.editable}}draggable="true"{{/if}}>
            <header class="sp-group-head sphere-head" data-spheres-toggle role="button" tabindex="0"
                    aria-expanded="{{#if sphere.groupOpen}}true{{else}}false{{/if}}"
                    data-spheres-context data-context-type="sphere" data-spheres-item-id="{{ sphere.id }}">
                <i class="fas fa-chevron-right sp-chevron" inert></i>
                <img src="{{ sphere.img }}" alt="">
                <span class="sphere-name">{{ sphere.name }}</span>
                <span class="sp-count">{{ sphere.talents.length }}</span>
                {{#if sphere.override}}<span class="spheres-tag override" data-tooltip="{{#if sphere.overrideNote}}{{ sphere.overrideNote }}{{else}}{{ localize "DND5E-SPHERES.Override.NoNote" }}{{/if}}">{{ localize "DND5E-SPHERES.Override.Badge" }}</span>{{/if}}
                {{#if sphere.picksLeft}}
                <button type="button" class="spheres-tag picks" data-spheres-action="freePicks" data-spheres-item-id="{{ sphere.id }}">
                    <i class="fas fa-gift" inert></i> {{ localize "DND5E-SPHERES.FreePicks.Pending" }}
                </button>
                {{/if}}
                <span class="sphere-abilities">
                    {{#each sphere.abilities}}
                    <button type="button" class="spheres-button" data-spheres-action="cast" data-spheres-item-id="{{ itemId }}"
                            data-activity-id="{{ activityId }}" {{#unless @root.spheres.owner}}disabled{{/unless}}>
                        <i class="fas fa-wand-magic-sparkles" inert></i> {{ name }}{{#if cost}} ({{ cost }}){{/if}}
                    </button>
                    {{/each}}
                </span>
            </header>
            <ol class="sp-list" data-sort-group="talents-{{ sphere.key }}">
                {{#each sphere.talents as |row|}}
                {{#> row row=row type="talent" editable=@root.spheres.editable }}
                    {{#if row.category}}<span class="spheres-tag category">{{ row.category }}</span>{{/if}}
                    {{#if row.advanced}}<span class="spheres-tag advanced">{{ localize "DND5E-SPHERES.Advanced" }}</span>{{/if}}
                    {{#if row.custom}}<span class="spheres-tag custom">{{ localize "DND5E-SPHERES.Custom.Badge" }}</span>{{/if}}
                    {{#if row.override}}<span class="spheres-tag override" data-tooltip="{{#if row.overrideNote}}{{ row.overrideNote }}{{else}}{{ localize "DND5E-SPHERES.Override.NoNote" }}{{/if}}">{{ localize "DND5E-SPHERES.Override.Badge" }}{{#if row.overrideNote}}: {{ row.overrideNote }}{{/if}}</span>
                    {{else if row.included}}<span class="spheres-tag free">{{ localize "DND5E-SPHERES.Included" }}</span>
                    {{else if row.freePick}}<span class="spheres-tag free">{{ localize "DND5E-SPHERES.FreePicks.Badge" }}</span>
                    {{else if row.free}}<span class="spheres-tag free">{{ localize "DND5E-SPHERES.Free" }}</span>{{/if}}
                    {{#if row.picksLeft}}<button type="button" class="spheres-tag picks" data-spheres-action="freePicks" data-spheres-item-id="{{ row.id }}"><i class="fas fa-gift" inert></i> {{ localize "DND5E-SPHERES.FreePicks.Pending" }}</button>{{/if}}
                    {{#if row.cost}}<span class="spheres-tag cost">{{ row.cost }} SP</span>{{/if}}
                {{/row}}
                {{else}}
                <li class="hint sp-empty">{{ localize "DND5E-SPHERES.NoTalentsYet" }}</li>
                {{/each}}
            </ol>
        </section>
        {{/each}}
        </div>
        {{#if orphanTalents.length}}
        <section class="sp-group open orphan" data-collapse-key="group.orphans">
            <header class="sp-group-head" data-spheres-toggle role="button" tabindex="0" aria-expanded="true">
                <i class="fas fa-chevron-right sp-chevron" inert></i>
                <span>{{ localize "DND5E-SPHERES.OrphanTalents" }}</span>
            </header>
            <ol class="sp-list" data-sort-group="orphans">
                {{#each orphanTalents as |row|}}
                {{#> row row=row type="talent" editable=@root.spheres.editable }}{{/row}}
                {{/each}}
            </ol>
        </section>
        {{/if}}
        {{else}}
        <p class="hint">{{ localize "DND5E-SPHERES.NoSpheres" }}</p>
        {{/if}}
    </div>

{{/with}}
</div>

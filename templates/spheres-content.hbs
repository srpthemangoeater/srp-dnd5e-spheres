{{!-- Per-item controls: post to chat always; edit and delete in edit mode. --}}
{{#*inline "itemControls"}}
<span class="item-controls">
    <a class="item-control" data-spheres-action="chat" data-spheres-item-id="{{ id }}"
       data-tooltip="DND5E-SPHERES.PostToChat" aria-label="{{ localize 'DND5E-SPHERES.PostToChat' }}"><i class="fas fa-comment" inert></i></a>
    {{#if editable}}
    <a class="item-control" data-spheres-action="edit" data-spheres-item-id="{{ id }}"
       data-tooltip="DND5E-SPHERES.EditItem" aria-label="{{ localize 'DND5E-SPHERES.EditItem' }}"><i class="fas fa-pen" inert></i></a>
    <a class="item-control delete" data-spheres-action="delete" data-spheres-item-id="{{ id }}"
       data-tooltip="DND5E-SPHERES.DeleteItem" aria-label="{{ localize 'DND5E-SPHERES.DeleteItem' }}"><i class="fas fa-trash" inert></i></a>
    {{/if}}
</span>
{{/inline}}

<div class="dnd5e-spheres-content {{#if spheres.editable}}editing{{/if}}">
{{#with spheres}}

    {{!-- Casting tradition --}}
    <div class="spheres-card tradition">
        <div class="spheres-card-header">
            <div>
                {{#if tradition}}
                <a class="tradition-name" data-spheres-action="openItem" data-spheres-item-id="{{ tradition.id }}">{{ tradition.name }}</a>
                {{else}}
                <span class="tradition-name empty">{{ localize "DND5E-SPHERES.NoTradition" }}</span>
                {{/if}}
                <div class="subtitle">
                    {{#if kamLabel}}
                    {{ localize "DND5E-SPHERES.KeyAbility" }}: {{ kamLabel }} ({{ dnd5e-formatModifier kamMod }})
                    &middot; {{ localize "DND5E-SPHERES.SphereDC" }} {{ dc }}
                    &middot; {{ localize "DND5E-SPHERES.Attack" }} {{ dnd5e-formatModifier attack }}
                    {{else}}
                    {{ localize "DND5E-SPHERES.NoKeyAbility" }}
                    {{/if}}
                </div>
            </div>
            <span class="header-buttons">
                {{#if tradition}}
                <button type="button" class="spheres-button icon" data-spheres-action="traditionChat"
                        data-tooltip="DND5E-SPHERES.PostToChat" aria-label="{{ localize 'DND5E-SPHERES.PostToChat' }}">
                    <i class="fas fa-comment" inert></i>
                </button>
                {{/if}}
                {{#if owner}}
                <button type="button" class="spheres-button" data-spheres-action="builder">
                    <i class="fas fa-pen-ruler" inert></i> {{ localize "DND5E-SPHERES.EditTradition" }}
                </button>
                {{/if}}
            </span>
        </div>

        <div class="spheres-tags" data-sort-group="drawbacks">
            {{#each drawbacks}}
            <span class="spheres-tag drawback" data-sort-id="{{ id }}" {{#if ../editable}}draggable="true"{{/if}}>
                <a data-spheres-action="openItem" data-spheres-item-id="{{ id }}">{{ name }}{{#if (gt count 1)}} &times;{{ count }}{{/if}}{{#if (gt weight 1)}} <span class="weight">({{ weight }})</span>{{/if}}</a>
                {{> itemControls id=id editable=../editable }}
            </span>
            {{/each}}
        </div>
        <div class="spheres-tags" data-sort-group="boons">
            {{#each boons}}
            <span class="spheres-tag boon" data-sort-id="{{ id }}" {{#if ../editable}}draggable="true"{{/if}}>
                <a data-spheres-action="openItem" data-spheres-item-id="{{ id }}">{{ name }}</a>
                {{> itemControls id=id editable=../editable }}
            </span>
            {{/each}}
            {{#if traditionBonus}}
            <span class="spheres-tag bonus">{{ localize "DND5E-SPHERES.TraditionBonus" bonus=traditionBonus }}</span>
            {{/if}}
        </div>
    </div>

    {{!-- Spell points --}}
    <div class="spheres-card pool">
        <div class="spheres-card-header">
            <h3><i class="fas fa-atom" inert></i> {{ localize "DND5E-SPHERES.SpellPoints" }}</h3>
            <span class="spheres-tag cap" data-tooltip="DND5E-SPHERES.CapHint">{{ localize "DND5E-SPHERES.Cap" cap=cap }}</span>
        </div>
        {{#if pool.exists}}
        <div class="pool-row">
            <span class="pool-value">{{ pool.value }} / {{ pool.max }}</span>
            <div class="pips" aria-hidden="true">
                {{#each pips}}<i class="pip {{#if spent}}spent{{/if}}"></i>{{/each}}
            </div>
            {{#if owner}}
            <div class="pool-controls">
                <button type="button" class="spheres-button icon" data-spheres-action="spend"
                        data-tooltip="DND5E-SPHERES.SpendOne" aria-label="{{ localize 'DND5E-SPHERES.SpendOne' }}">
                    <i class="fas fa-minus" inert></i>
                </button>
                <button type="button" class="spheres-button icon" data-spheres-action="restore"
                        data-tooltip="DND5E-SPHERES.RestoreOne" aria-label="{{ localize 'DND5E-SPHERES.RestoreOne' }}">
                    <i class="fas fa-plus" inert></i>
                </button>
                <button type="button" class="spheres-button" data-spheres-action="usePool">
                    <i class="fas fa-wand-magic-sparkles" inert></i> {{ localize "DND5E-SPHERES.UsePool" }}
                </button>
            </div>
            {{/if}}
        </div>
        <div class="pool-breakdown">
            {{ localize "DND5E-SPHERES.Breakdown" class=classSP kam=kamMod tradition=traditionBonus manual=manual }}
        </div>
        {{else}}
        <p class="hint">{{ localize "DND5E-SPHERES.NoPool" }}</p>
        {{#if owner}}
        <button type="button" class="spheres-button" data-spheres-action="createPool">
            <i class="fas fa-plus" inert></i> {{ localize "DND5E-SPHERES.CreatePool" }}
        </button>
        {{/if}}
        {{/if}}
    </div>

    {{!-- Spheres & talents --}}
    <div class="spheres-card list">
        <div class="spheres-card-header">
            <h3>{{ localize "DND5E-SPHERES.SpheresAndTalents" }}</h3>
            <span class="header-buttons">
                <span class="spheres-tag talents {{#if talentTracker.over}}over{{/if}}"
                      data-tooltip="{{ localize 'DND5E-SPHERES.TalentsHint' classes=talentTracker.fromClasses tradition=talentTracker.tradition bonus=talentTracker.bonus }}">
                    {{ localize "DND5E-SPHERES.TalentsUsed" spent=talentTracker.spent total=talentTracker.total }}
                </span>
                {{#if owner}}
                <button type="button" class="spheres-button" data-spheres-action="browse">
                    <i class="fas fa-book-atlas" inert></i> {{ localize "DND5E-SPHERES.Browser.Open" }}
                </button>
                {{/if}}
            </span>
        </div>
        {{#if talentTracker.over}}
        <p class="warning">{{ localize "DND5E-SPHERES.TalentsOver" }}</p>
        {{/if}}
        {{#if hasSpheres}}
        <div class="sphere-list" data-sort-group="spheres">
        {{#each sphereList}}
        <div class="sphere-entry" data-sort-id="{{ id }}" {{#if ../editable}}draggable="true"{{/if}}>
            <div class="sphere-head">
                <span class="sphere-title">
                    {{#if ../editable}}<i class="fas fa-grip-vertical drag-handle" inert></i>{{/if}}
                    <a class="sphere-name" data-spheres-action="openItem" data-spheres-item-id="{{ id }}"><img src="{{ img }}" alt=""> {{ name }}</a>
                    {{> itemControls id=id editable=../editable }}
                </span>
                <span class="sphere-abilities">
                    {{#each abilities}}
                    <button type="button" class="spheres-button" data-spheres-action="cast" data-spheres-item-id="{{ ../id }}"
                            data-activity-id="{{ activityId }}" {{#unless @root.spheres.owner}}disabled{{/unless}}>
                        <i class="fas fa-wand-magic-sparkles" inert></i> {{ name }}{{#if cost}} ({{ cost }}){{/if}}
                    </button>
                    {{/each}}
                </span>
            </div>
            {{#if talents.length}}
            <ul class="spheres-items" data-sort-group="talents-{{ key }}">
                {{#each talents}}
                <li class="talent" data-sort-id="{{ id }}" {{#if ../../editable}}draggable="true"{{/if}}>
                    {{#if ../../editable}}<i class="fas fa-grip-vertical drag-handle" inert></i>{{/if}}
                    <a data-spheres-action="openItem" data-spheres-item-id="{{ id }}"><img src="{{ img }}" alt=""> {{ name }}</a>
                    {{#if advanced}}<span class="spheres-tag advanced">{{ localize "DND5E-SPHERES.Advanced" }}</span>{{/if}}
                    {{#if free}}<span class="spheres-tag free">{{ localize "DND5E-SPHERES.Free" }}</span>{{/if}}
                    {{#if cost}}<span class="spheres-tag">{{ cost }} SP</span>{{/if}}
                    {{> itemControls id=id editable=../../editable }}
                </li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
        </div>
        {{#if orphanTalents.length}}
        <div class="sphere-entry orphan">
            <div class="sphere-head"><span class="sphere-name">{{ localize "DND5E-SPHERES.OrphanTalents" }}</span></div>
            <ul class="spheres-items" data-sort-group="orphans">
                {{#each orphanTalents}}
                <li class="talent" data-sort-id="{{ id }}" {{#if ../editable}}draggable="true"{{/if}}>
                    <a data-spheres-action="openItem" data-spheres-item-id="{{ id }}"><img src="{{ img }}" alt=""> {{ name }}</a>
                    {{> itemControls id=id editable=../editable }}
                </li>
                {{/each}}
            </ul>
        </div>
        {{/if}}
        {{else}}
        <p class="hint">{{ localize "DND5E-SPHERES.NoSpheres" }}</p>
        {{/if}}
    </div>

{{/with}}
</div>
